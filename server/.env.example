DATABASE_URL=postgresql://user:password@localhost:5432/campusshare
JWT_SECRET=replace_with_a_long_random_string_of_at_least_32_characters
PORT=5000

# Your frontend URL(s), comma separated, no trailing slash (e.g. https://campus-share.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Optional: restrict sign-up to your college, e.g. mithibai.ac.in (comma separated)
ALLOWED_EMAIL_DOMAINS=

# Optional: a secret code teachers type at sign-up to get a TEACHER account. Leave empty to disable.
# (Without it, promote users with: npm run set-role -- email@college.edu TEACHER)
TEACHER_INVITE_CODE=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
